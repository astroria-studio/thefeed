{
  "name": "arealisticdreamer",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "EDITION": "global"
  },
  "routes": [
    {
      "pattern": "arealisticdreamer.com",
      "custom_domain": true
    }
  ]
}